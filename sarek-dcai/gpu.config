//Include the overwrite file
includeConfig "container_overrides.config"

//Set resource limits for Gefion
params {
    //DGX nodes max limits
    max_memory                   = 2000.GB
    max_cpus                     = 224
    max_time                     = 168.h
}

//Enable use of Apptainer on Gefion for running jobs in containers
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/path/to/project/img/'
    runOptions = '--env PATH=$PATH:/opt/conda/bin:/opt/conda/condabin'
}

//Default Process Configuration
process {
    beforeScript = 'ml load apptainer;'
    resourceLimits = [
        memory: 2000.GB,
        cpus:    224,
        time:    168.h
    ]
    executor       = 'slurm'
    queue          = 'QUEUE_NAME'
    clusterOptions = '--account=ACCOUNT_NAME'
}

//Manual Process Overrides
process {
    withName: FASTQC {
        containerOptions = '--env PATH=\$PATH:/FastQC --env JAVA_TOOL_OPTIONS=-Djava.awt.headless=true'
    }
    withName: GATK4_HAPLOTYPECALLER {
        cpus = 6
        memory = '32.GB'
        time = '12.h'
        containerOptions = '--env PATH=/opt/conda/bin:\$PATH --env OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK'
    }
    withName: GATK4_CNNSCOREVARIANTS {
        containerOptions = '--env PATH=/gatk:/opt/miniconda/envs/gatk/bin:/opt/miniconda/bin:/opt/miniconda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    }
    withName: PARABRICKS_FQ2BAM {
        clusterOptions = '--gpus=8 --account=ACCOUNT_NAME'
        memory = 2000.GB
        cpus = 224
        containerOptions = '--nv --env PATH=\$PATH:/usr/local/parabricks --env LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:\$LD_LIBRARY_PATH'
    }
    withName: 'BWAMEM2_MEM' {
        errorStrategy   = { task.exitStatus in 125..140 ? 'retry' : 'terminate' }
        cpus            = { 12 * task.attempt }
        memory          = { 96.GB * task.attempt }
        maxRetries = 3
    }
}
